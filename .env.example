# ============================================================
# 연구실 IP 등록 봇 — 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 실제 값을 채워 사용하세요.
# ⚠️  .env 파일은 절대 git에 커밋하지 마세요 (.gitignore 확인 필수)
# ============================================================

# [필수] Discord 봇 토큰 (Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=your_bot_token_here

# ============================================================
# 길드(서버) 설정 — 1개 이상, 번호를 이어서 추가
# GUILD_N_ID         : 서버 ID
# GUILD_N_CHANNEL_ID : 명령어 사용 가능 채널 ID (비워두면 모든 채널 허용)
# GUILD_N_ROLE_ID    : 명령어 사용 가능 역할 ID (비워두면 모든 멤버 허용)
# ============================================================

GUILD_1_ID=your_guild_id_here
GUILD_1_CHANNEL_ID=your_channel_id_here
GUILD_1_ROLE_ID=your_role_id_here

# GUILD_2_ID=your_guild_id_here
# GUILD_2_CHANNEL_ID=your_channel_id_here
# GUILD_2_ROLE_ID=your_role_id_here

# ============================================================
# IP 설정
# ============================================================

# 등록 허용 IP 서브넷 앞 3옥텟 (예: 192.168.1)
IP_PREFIX=your_ip_prefix_here

# ============================================================
# 웹서버 설정 (IP 자동 감지 claim 엔드포인트)
# ============================================================

# 웹서버 바인딩 주소 (기본값: 127.0.0.1)
# 랩 내부에서 접근하려면 NAS의 내부 IP로 변경하세요
WEB_HOST=127.0.0.1

# 웹서버 포트 (기본값: 8080)
WEB_PORT=8080

# 클라이언트가 실제로 접속하는 공개 URL
# Docker/NAT 환경에서는 호스트 IP 또는 도메인으로 변경하세요
# 예: http://192.168.1.100:8080  또는  https://labip.example.com
WEB_BASE_URL=http://localhost:8080

# ============================================================
# 토큰 설정
# ============================================================

# Claim 토큰 유효 시간(초) — 기본값: 300 (5분)
TOKEN_TTL_SECONDS=300

# Rate Limit 설정 (/ip/claim 엔드포인트)
# RATE_LIMIT_WINDOW초 동안 IP당 최대 RATE_LIMIT_MAX회 허용
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=10

# ============================================================
# 데이터 파일 경로 (기본값 그대로 사용 권장)
# ============================================================

IP_STATE_FILE=data/ip-state.json
TOKEN_FILE=data/ip-tokens.json

# 시간대
TZ=Asia/Seoul
